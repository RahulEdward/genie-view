# Application Settings
APP_NAME=Trading Backend
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000
WS_PORT=8765

# Database Settings (for local development - SQLite by default)
# Leave empty to use SQLite, or set PostgreSQL URL for production
DATABASE_URL=

# Docker Database Settings
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading123
POSTGRES_DB=trading_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
OPTION_CHAIN_CACHE_TTL=30

# Broker Settings
BROKER_NAME=angelone

# Angel One Settings
ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PASSWORD=your_password
ANGELONE_TOTP_SECRET=your_totp_secret

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
